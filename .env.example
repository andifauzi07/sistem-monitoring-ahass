# Salin menjadi `.env` lalu isi dari Supabase Dashboard → Project Settings → API Keys.
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Konfigurasi Supabase Edge Function: kirim-wa (Iterasi 7)
# Di Supabase Cloud, atur melalui: Supabase Dashboard → Project Settings → Edge Functions → Secrets
# Atau melalui CLI:
#   supabase secrets set WAPISENDER_API_KEY="xxx" WAPISENDER_DEVICE_KEY="xxx" APP_PUBLIC_URL="https://monitoring-ahass-mamuju.vercel.app"
WAPISENDER_API_KEY=
WAPISENDER_DEVICE_KEY=
APP_PUBLIC_URL=https://monitoring-ahass-mamuju.vercel.app
